# =============================================
# Zidra Job Portal - Environment Configuration
# =============================================
# Copy this file: cp .env.example .env
# Then fill in your actual values below

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Local development:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zidra_db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# JWT Authentication
JWT_SECRET=zidra_super_secret_key_change_this_2024
JWT_EXPIRES_IN=7d

# Admin default credentials (created on first run)
ADMIN_EMAIL=admin@zidra.com
ADMIN_DEFAULT_PASSWORD=Admin@1234

# Email (Gmail SMTP - optional, app works without it)
# To enable: create Gmail App Password at myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Zidra Job Portal <your@gmail.com>

# File Upload
MAX_FILE_SIZE=5242880

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
